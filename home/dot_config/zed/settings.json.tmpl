{
  "tab_bar": {
    "show": true
  },
  "diagnostics": {
    "button": true
  },
  "terminal": {
    "button": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_language_button": true
  },
  "language_models": {
    "openai_compatible": {
      "MiniMax": {
        "api_url": "https://api.minimaxi.com/v1",
        "available_models": [
          {
            "name": "MiniMax-M3",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true
            }
          }
        ]
      }
    }
  },
  "project_panel": {
    "button": true,
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "redact_private_values": false,
  "agent": {
    "button": true,
    "sidebar_side": "left",
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "provider": "MiniMax",
      "model": "MiniMax-M3"
    }
  },

  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "system",
    "light": "Nord Light",
    "dark": "Nord"
  },
  "ui_font_family": "{{ .visual.fontFamily }}",
  "ui_font_size": {{ .visual.terminal.fontSize }},
  "buffer_font_family": "{{ .visual.alternateFontFamily }}",
  "buffer_font_size": {{ .visual.terminal.fontSize }},

  "minimap": {
    "show": "auto"
  },
  "tabs": {
    "close_position": "left",
    "git_status": false
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_user_menu": false,
    "show_branch_status_icon": true,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_picture": false
  },

  "autosave": "on_focus_change",

  "when_closing_with_no_tabs": "close_window",
  "on_last_window_closed": "quit_app"
}
